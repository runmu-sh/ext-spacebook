{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spacebook.Profile",
  "$comment": "The answer to Spacebook.GetProfile: someone's card with their friends (for an NPC, the people it could introduce you to), or {key, name, error} when they cannot be found or the profile is private.",
  "type": "object",
  "required": [
    "key",
    "name"
  ],
  "properties": {
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "portrait": {
      "type": "string"
    },
    "acquaintance": {
      "type": "string"
    },
    "blurb": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "buddy": {
      "type": "boolean"
    },
    "viewable": {
      "type": "boolean",
      "$comment": "The viewer may ask for this profile."
    },
    "error": {
      "type": "string",
      "$comment": "Set instead of the rest when they cannot be found or the profile is private."
    },
    "shares_friends": {
      "type": "boolean"
    },
    "friends_visible": {
      "type": "boolean"
    },
    "friends_hidden": {
      "type": "string",
      "$comment": "Why the friends are not shown; '' when they are."
    },
    "friends": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "introducer": {
      "type": "boolean",
      "$comment": "An NPC: its friends are the people it could introduce you to."
    },
    "learned": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/learned"
      },
      "$comment": "What the viewer learned about them; empty for yourself."
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      },
      "$comment": "The viewer's own notes on them; empty for yourself."
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": [
        "key",
        "name"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "portrait": {
          "type": "string"
        },
        "acquaintance": {
          "type": "string"
        },
        "blurb": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "buddy": {
          "type": "boolean"
        },
        "viewable": {
          "type": "boolean",
          "$comment": "The viewer may ask for this profile."
        }
      }
    },
    "learned": {
      "type": "object",
      "required": [
        "field",
        "value"
      ],
      "$comment": "A detail the viewer learned (today: what an NPC likes or loves).",
      "properties": {
        "field": {
          "type": "string",
          "$comment": "\"loves\" or \"likes\""
        },
        "label": {
          "type": "string",
          "$comment": "The field's display label (\"Loves\")."
        },
        "id": {
          "type": "string",
          "$comment": "The preference id."
        },
        "value": {
          "type": "string",
          "$comment": "The preference label (\"real-grain whisky\")."
        },
        "source": {
          "type": "string",
          "$comment": "told | gift | delivery"
        },
        "time": {
          "type": "integer"
        }
      }
    },
    "note": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "$comment": "One of the viewer's private notes.",
      "properties": {
        "id": {
          "type": "integer",
          "$comment": "Unique per viewer, never reused."
        },
        "text": {
          "type": "string"
        },
        "time": {
          "type": "integer"
        },
        "edited": {
          "type": "integer",
          "$comment": "0 = never edited."
        }
      }
    }
  }
}
